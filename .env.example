# Optional Gemma via Ollama. Install Ollama and run: ollama pull gemma3:4b
GEMMA_API_URL=http://localhost:11434/api/chat
GEMMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_SECONDS=45
# Optional storage override. On Render Blueprint, DATA_FILE is /var/data/matches.json.
# DATA_FILE=./data/matches.json
PLAYER_FOCUS=finishing
